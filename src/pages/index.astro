---
import Layout from '../layouts/Layout.astro';
import ProfileCard from '../components/ProfileCard.astro';
import {
  person,
  headline,
  seeking,
  knowsAbout,
  projects,
  faqs,
  graphJsonLd,
  faqJsonLd,
  projectHref,
  siteUrl,
  tradingStackIntro,
  isTradingStack,
} from '../data/site';

const featured = projects.filter((project) => project.featured);
const tradingFeatured = featured.filter(isTradingStack);
const otherFeatured = featured.filter((project) => !isTradingStack(project));
const title = `${person.name} — ${person.jobTitle}`;
---

<Layout title={title} description={headline} jsonLd={graphJsonLd(`${siteUrl}/`, title, [faqJsonLd()])}>
  <article>
    <ProfileCard />

    <div class="stack">
      <section class="enter">
        <h2>Roles I am open to</h2>
        <ul class="list">
          {seeking.map((role) => <li>{role}</li>)}
        </ul>
      </section>

      <section class="enter">
        <h2>Selected work</h2>
        <p class="section-note">{tradingStackIntro}</p>
        <div class="cards">
          {tradingFeatured.map((project) => (
            <a class="card press" href={projectHref(project)}>
              <h3>{project.name}</h3>
              <p>{project.scope}</p>
              <span class="card-meta">Read the write-up</span>
            </a>
          ))}
        </div>
        {otherFeatured.length > 0 && (
          <div class="cards">
            {otherFeatured.map((project) => (
              <a class="card press" href={projectHref(project)}>
                <h3>{project.name}</h3>
                <p>{project.scope}</p>
                <span class="card-meta">Read the write-up</span>
              </a>
            ))}
          </div>
        )}
        <p><a href="/work/">All of my public work</a></p>
      </section>

      <section>
        <h2>What I work with</h2>
        <ul class="chips">
          {knowsAbout.map((topic) => <li>{topic}</li>)}
        </ul>
      </section>

      <section>
        <h2>Questions I get asked</h2>
        <dl class="faq">
          {faqs.map((faq) => (
            <>
              <dt>{faq.question}</dt>
              <dd>{faq.answer}</dd>
            </>
          ))}
        </dl>
      </section>
    </div>
  </article>
</Layout>
